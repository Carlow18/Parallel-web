{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": {
    "name": { "$value": "Parallel", "$type": "string" },
    "northStar": { "$value": "The Tally Light Table", "$type": "string" }
  },
  "color": {
    "brand": {
      "tallyRed": { "$value": "#D91E18", "$type": "color", "$description": "Primary CTA, active 2x hover ring, tally badge, focus ring" },
      "tallyRedDeep": { "$value": "#B51611", "$type": "color", "$description": "Primary hover/active fill, small red text, error ink" },
      "tallyRedBright": { "$value": "#FF423B", "$type": "color", "$description": "High-contrast red accent on dark screening-black surfaces" },
      "tallyRedWash": { "$value": "#FCECEB", "$type": "color", "$description": "Broken-clip error tile surface and destructive hover wash" }
    },
    "neutral": {
      "carbonInk": { "$value": "#111113", "$type": "color", "$description": "Primary text, active filter pill, tactile ink borders" },
      "inkSecondary": { "$value": "#4B4A4E", "$type": "color", "$description": "Body descriptions and unselected filter text" },
      "inkMuted": { "$value": "#636266", "$type": "color", "$description": "Timestamps, clip counts, hostnames, keyboard hints" },
      "paperCanvas": { "$value": "#F6F5F2", "$type": "color", "$description": "Global archival light-table background" },
      "surfaceCard": { "$value": "#FFFFFF", "$type": "color", "$description": "Drawers, popovers, secondary button fills" },
      "surfaceWell": { "$value": "#ECEAE4", "$type": "color", "$description": "Unloaded video frames, inactive pills, recessed wells" },
      "surfaceWellHover": { "$value": "#E2DFD7", "$type": "color", "$description": "Inactive pill hover fill" },
      "hairlineBorder": { "$value": "#DCD9D0", "$type": "color", "$description": "Subtle dividers and resting video card frame border" }
    },
    "screening": {
      "black": { "$value": "#0E0E10", "$type": "color", "$description": "1x lightbox modal backdrop and cinema canvas" },
      "surface": { "$value": "#1A1A1E", "$type": "color", "$description": "Lightbox utility bar and controls" },
      "border": { "$value": "#2C2C32", "$type": "color", "$description": "Lightbox internal dividers" },
      "text": { "$value": "#F6F5F2", "$type": "color", "$description": "Primary text inside lightbox" },
      "muted": { "$value": "#A4A3A8", "$type": "color", "$description": "Secondary metadata inside lightbox" }
    },
    "semantic": {
      "success": { "$value": "#157A4B", "$type": "color" },
      "successWash": { "$value": "#E8F5EE", "$type": "color" },
      "warning": { "$value": "#9A5B00", "$type": "color" },
      "warningWash": { "$value": "#FEF5E4", "$type": "color" },
      "error": { "$value": "#B51611", "$type": "color" },
      "errorWash": { "$value": "#FCECEB", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"], "$type": "fontFamily" },
      "sans": { "$value": ["Figtree", "system-ui", "sans-serif"], "$type": "fontFamily" },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$type": "fontFamily" }
    },
    "scale": {
      "display": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.display}", "fontSize": "40px", "fontWeight": 700, "lineHeight": 1.08, "letterSpacing": "-0.03em" }
      },
      "headline": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.display}", "fontSize": "24px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.02em" }
      },
      "title": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.display}", "fontSize": "18px", "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": "-0.015em" }
      },
      "body": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.55, "letterSpacing": "0em" }
      },
      "ui": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.25, "letterSpacing": "-0.005em" }
      },
      "label": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.35, "letterSpacing": "0em" }
      },
      "monoBadge": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.mono}", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "0.04em" }
      }
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "badge": { "$value": "6px", "$type": "dimension" },
    "control": { "$value": "8px", "$type": "dimension" },
    "card": { "$value": "10px", "$type": "dimension" },
    "modal": { "$value": "14px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "layout": {
    "containerMax": { "$value": "1600px", "$type": "dimension" },
    "topbarHeight": { "$value": "56px", "$type": "dimension" },
    "filterbarHeight": { "$value": "48px", "$type": "dimension" },
    "gutterDesktop": { "$value": "24px", "$type": "dimension" },
    "gutterMobile": { "$value": "16px", "$type": "dimension" },
    "gridGapDesktop": { "$value": "16px", "$type": "dimension" },
    "gridGapMobile": { "$value": "12px", "$type": "dimension" }
  },
  "shadow": {
    "tactileLip": { "$value": "0 2px 0 #111113", "$type": "shadow" },
    "tactileLift": { "$value": "0 3px 0 #111113", "$type": "shadow" },
    "tallyActive": { "$value": "0 0 0 2px #D91E18, 0 8px 20px rgba(17, 17, 19, 0.10)", "$type": "shadow" },
    "drawer": { "$value": "0 12px 32px rgba(17, 17, 19, 0.12)", "$type": "shadow" },
    "screening": { "$value": "0 24px 64px rgba(14, 14, 16, 0.55)", "$type": "shadow" }
  },
  "motion": {
    "easing": {
      "tactile": { "$value": [0.22, 1, 0.36, 1], "$type": "cubicBezier" },
      "pop": { "$value": [0.34, 1.56, 0.64, 1], "$type": "cubicBezier" }
    },
    "duration": {
      "instant": { "$value": "110ms", "$type": "duration" },
      "tally": { "$value": "160ms", "$type": "duration" },
      "modal": { "$value": "220ms", "$type": "duration" }
    }
  }
}
